# Chave da API Anthropic, usada pelo analyzer.py para gerar o rascunho de cada processo
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Chave service_role do Supabase: bypassa RLS, então só fica no .env da máquina do agente
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
