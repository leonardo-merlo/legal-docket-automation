# URL pública canônica do site em produção (ex: https://controladoria.exemplo-adv.example)
# Usada para montar links de convite e redefinição de senha nos e-mails do Supabase Auth.
# Sem essa variável, o app cai para o header Host da requisição — só seguro em desenvolvimento local.
NEXT_PUBLIC_SITE_URL=

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima/pública do Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role do Supabase — NUNCA expor no client, só em código server-side (Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API da Anthropic, usada para classificação de processos via Claude (dependência @anthropic-ai/sdk já presente no package.json)
ANTHROPIC_API_KEY=

# Client ID do OAuth do Google, tipo "Aplicativo da Web" (Google Cloud > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Client secret do mesmo client OAuth — só server-side, nunca no client
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Chave AES-256-GCM que cifra o refresh token do Gmail no banco: 32 bytes aleatórios em base64
GMAIL_TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY

# Segredo do Bearer que o pg_cron envia para POST /api/gmail/sincronizar (o mesmo valor fica no Vault do Supabase)
GMAIL_SYNC_SECRET=YOUR_GMAIL_SYNC_SECRET

# Modo da ingestão do Gmail: "sombra" (padrão; lê e registra sem tocar em processos) ou "ativo"
GMAIL_INGESTAO_MODO=sombra

# Obrigatória no modo ativo: só pautas com data DEPOIS desta (DD/MM/AAAA) vão para processos
GMAIL_LOTE_CORTE=

# Opcional: remetentes aceitos, separados por vírgula (padrão: intimacoes@exemplo-adv.example,oabmg@recortedigital.adv.br)
GMAIL_REMETENTES=
